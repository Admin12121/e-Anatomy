COMPOSE_PROJECT_NAME=anatomy

# First-run server hardening. Prefer DEPLOY_AUTHORIZED_KEYS with password SSH
# disabled. If you intentionally bootstrap with a password, set
# SSH_PASSWORD_AUTH=true and set DEPLOY_PASSWORD to a strong temporary value.
HARDEN_SERVER=true
DEPLOY_USER=altharld
DEPLOY_PASSWORD=
DEPLOY_APP_DIR=/srv/anatomy/app
DEPLOY_SYNC_PROJECT=true
DEPLOY_AUTHORIZED_KEYS=
SSH_PORT=22
SSH_PASSWORD_AUTH=false
UFW_ENABLE=true
UFW_ALLOW_PORTS=80/tcp,443/tcp
FAIL2BAN_ENABLE=true
JOURNALD_PERSISTENT=true
UNATTENDED_UPGRADES_ENABLE=true

# Host PostgreSQL provisioning. The deploy script uses these values to create
# the application role/database on the host PostgreSQL server.
POSTGRES_USE_SUDO=true
POSTGRES_ADMIN_SYSTEM_USER=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_DB=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=anatomy
POSTGRES_USER=anatomy
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://anatomy:change-me-strong-password@127.0.0.1:5432/anatomy
AUTH_DATABASE_URL=postgres://anatomy:change-me-strong-password@127.0.0.1:5432/anatomy
DATABASE_MAX_CONNECTIONS=10

# Host directories mounted into Docker containers. These keep uploaded media
# and derived study data outside Docker volumes.
HOST_UPLOADS_DIR=/srv/anatomy/uploads
HOST_API_DATA_DIR=/srv/anatomy/api-data
HOST_CERTBOT_WEBROOT=/srv/anatomy/certbot/www

# Public domain and TLS. APP_DOMAIN must already resolve to this server before
# the tls step can issue a Let's Encrypt certificate.
APP_DOMAIN=thevoxelanatomy.com
APP_DOMAIN_ALIASES=www.thevoxelanatomy.com
TLS_ENABLE=true
CERTBOT_EMAIL=admin@thevoxelanatomy.com
TLS_CERTBOT_INSTALL_METHOD=snap
TLS_RENEWAL_DRY_RUN=false
TLS_STAGING=false
TLS_FORCE_RENEWAL=false

# Production containers use host networking so they can reach host PostgreSQL
# through 127.0.0.1. Keep internal services bound to localhost unless you know
# exactly why they must be public.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
WEB_HOST=127.0.0.1
WEB_PORT=3000
REDIS_URL=redis://127.0.0.1:6379
RUST_LOG=info,sqlx=warn,dicom_object::meta=error
STORAGE_ROOT_DIR=/app/data

AUTH_COOKIE_NAME=anatomy_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_HOURS=168
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_ACCOUNT_SLUG=platform-admin

NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://127.0.0.1:8080/api/v1
NEXT_SERVER_API_PROXY_TARGET=http://127.0.0.1:8080
BETTER_AUTH_SECRET=change-me-at-least-32-random-characters
BETTER_AUTH_URL=https://thevoxelanatomy.com
BETTER_AUTH_TRUSTED_ORIGINS=https://thevoxelanatomy.com,https://www.thevoxelanatomy.com
BETTER_AUTH_PASSKEY_RP_ID=thevoxelanatomy.com
INTERNAL_WEB_API_KEY=change-me-internal-api-key

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_EMAIL_FROM=Anatomy Platform <no-reply@example.com>
RESEND_API_KEY=
RESEND_FROM=Anatomy Platform <no-reply@example.com>

PUBLIC_API_BASE_URL=/api/v1
SERVER_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
NEXT_PUBLIC_SITE_URL=https://thevoxelanatomy.com

# nginx-prod uses host networking and listens on ports 80 and 443.
HTTP_PORT=80
ALLOW_PUBLIC_INTERNAL_PORTS=false
